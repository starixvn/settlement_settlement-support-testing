<!DOCTYPE html>
<html>
<head>
    <title>API JT Monitor</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body onload="loadRequest()">

    <input type="text" id="requestInput" rows="4" cols="50" placeholder="BetType1-GoalLine1,BetType2-GoalLine2" />
        Ex: 1-1,7-0.5,8-(-0.5)
    <button onclick="addRequest()">Add Market</button>

    <ul id="requestList"></ul>
    <script>

        async function addRequest() {

            var input = document.getElementById("requestInput").value;
            if (input.trim() === "") {
                alert("Please input your markets!");
                return;
            }

            let response = await fetch('/api/monitor/SendMarket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ request: input })
            });

            if (!response.ok) {
                alert("Error: Please contact IT");
            } else {
                document.getElementById("requestInput").value = "";
                loadRequest(); 
            }
        }

        async function loadRequest() {

            let response = await fetch('/api/monitor/GetMarkets');
            if (response.ok) {
                let data = await response.json();
                updateList(data);
            } else {
                alert("Error: Please contact IT");
            }
        }

        async function clearMarket(betType, goalLine) {
            let response = await fetch('/api/monitor/ClearMarket', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ BetType: betType, GoalLine: goalLine })
            });

            if (!response.ok) {
                alert("Error: Unable to remove market");
            } else {
                loadRequest();
            }
        }

        function updateList(markets) {
            var list = document.getElementById("requestList");
            list.innerHTML = ""; // Clear old list

            markets.forEach(market => {
                let li = document.createElement("li");
                li.textContent = `BetType: ${market.BetType}, GoalLine: ${market.GoalLine} `;

                let clearButton = document.createElement("button");
                clearButton.textContent = "Clear";
                clearButton.onclick = () => clearMarket(market.BetType, market.GoalLine);

                li.appendChild(clearButton);
                list.appendChild(li);
            });
        }
    </script>
</body>
</html>