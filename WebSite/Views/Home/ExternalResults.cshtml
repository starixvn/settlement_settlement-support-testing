@{
    ViewData["Title"] = "Settlement Support Testing - External Results";
}

<div class="container">
    <a href="@Url.Action("Index", "Home")" class="back-link">← Back to Home</a>
    
    <h1>🌐 External Results Management</h1>
    
    <div class="form-section">
        <h2>External Results Configuration</h2>
        <form id="ExternalResultsForm">
            <div class="form-row">
                <div class="form-group">
                    <label for="matchId3rd">MatchId3rd (Default):</label>
                    <input type="number" id="matchId3rd" class="form-control" value="12365499" placeholder="Enter any number">
                </div>
                
                <div class="form-group">
                    <label for="matchId">MatchId:</label>
                    <input type="number" id="matchId" class="form-control" placeholder="MatchId - numbers only">
                </div>
            </div>
            
            <div class="form-group">
                <label for="sourceId">SourceId:</label>
                <select id="sourceId" class="form-control">
                    <option value="1">1 - SBO</option>
                    <option value="16">16 - PandaScore</option>
                    <option value="22">22 - GameScorekeeper</option>
                    <option value="23">23 - GRID</option>
                    <option value="24">24 - Weaverdat</option>
                    <option value="25">25 - LSport</option>
                    <option value="29">29 - BetConstruct</option>
                    <option value="30">30 - Abios</option>
                    <option value="31">31 - Sofascore</option>
                    <option value="32">32 - The Sports</option>
                    <option value="201">201 - BetRadar</option>
                    <option value="100">100 - Trader External</option>
                </select>
            </div>
            
            <div class="resources-section">
                <div class="resources-header">
                    <h4 class="resources-title">📊 Resources</h4>
                    <div class="btn-group">
                        <button id="add-result" type="button" class="btn btn-success">
                            ➕ Add Resource
                        </button>
                        <button id="remove-result" type="button" class="btn btn-danger">
                            🗑️ Remove Last
                        </button>
                    </div>
                </div>
                
                <div id="container-block">
                    <div id="result-block" class="resource-block">
                        <div class="result-child">
                            <div class="form-group">
                                <label for="resourceId">ResourceId:</label>
                                <input type="text" name="resourceId" class="form-control" placeholder="M1, M2, 00, 01, ...">
                            </div>
                            <div class="form-group">
                                <label for="homeValue">HomeValue:</label>
                                <input type="text" name="homeValue" class="form-control" placeholder="0, 1, 2, ...">
                            </div>
                            <div class="form-group">
                                <label for="awayValue">AwayValue:</label>
                                <input type="text" name="awayValue" class="form-control" placeholder="0, 1, 2, ...">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="form-group">
                <button type="button" id="form-submit" class="btn btn-primary">
                    📤 Submit External Results
                </button>
                <button type="button" id="clear-form" class="btn btn-secondary">
                    🗑️ Clear Form
                </button>
            </div>
        </form>
    </div>
    
    <div id="loading" class="loading">
        <div class="spinner"></div>
        <p>Processing your request...</p>
    </div>
    
    <div id="alert-container"></div>
</div>

@section Scripts {
    <script type="text/javascript">
        jQuery(window.document).ready(function () {
            site.init();
            
            // Override the form-submit click handler to use our custom function
            $('#form-submit').off('click').on('click', function (e) {
                site.pushExternalResults();
            });
        });

        $('#clear-form').click(function (e) {
            clearForm();
        });

        function showAlert(message, type = 'info') {
            // Show native alert for immediate feedback
            if (type === 'success') {
                alert(message);
            } else if (type === 'error') {
                alert(message);
            }

            // Also show custom alert
            const alertContainer = $('#alert-container');
            const alertClass = type === 'success' ? 'alert-success' :
                              type === 'error' ? 'alert-danger' : 'alert-info';

            alertContainer.html(`
                <div class="alert ${alertClass}">
                    ${message}
                </div>
            `);

            // Scroll to alert
            $('html, body').animate({
                scrollTop: alertContainer.offset().top - 100
            }, 500);

            // Auto-hide after 8 seconds for success, 10 seconds for error
            const hideTime = type === 'success' ? 8000 : 10000;
            setTimeout(() => {
                alertContainer.empty();
            }, hideTime);
        }

        function showLoading(show = true) {
            if (show) {
                $('#loading').show();
                $('#form-submit').prop('disabled', true);
            } else {
                $('#loading').hide();
                $('#form-submit').prop('disabled', false);
            }
        }

        function clearForm() {
            $('#matchId3rd').val('12365499');
            $('#matchId').val('');
            $('#sourceId').val('1');
            $('#container-block').html($('#result-block').prop('outerHTML'));
            $('#result-block').find('input').val('');
            $('#alert-container').empty();
        }

        function validationForm() {
            var matchId3rd = $('#matchId3rd').val();
            var matchId = $('#matchId').val();
            var sourceId = $('#sourceId').val();
            
            if (!matchId3rd || matchId3rd === "") {
                showAlert("❌ Please enter MatchId3rd", 'error');
                return false;
            }
            
            if (!matchId || matchId === "") {
                showAlert("❌ Please enter MatchId", 'error');
                return false;
            }
            
            if (!sourceId || sourceId === "") {
                showAlert("❌ Please select SourceId", 'error');
                return false;
            }
            
            // Validate resources
            var hasValidResource = false;
            $("input[name='resourceId']").each(function(index) {
                var resourceId = $(this).val();
                var homeValue = $("input[name='homeValue']").eq(index).val();
                var awayValue = $("input[name='awayValue']").eq(index).val();
                
                if (resourceId && homeValue && awayValue) {
                    hasValidResource = true;
                    return false; // break the loop
                }
            });
            
            if (!hasValidResource) {
                showAlert("❌ Please add at least one valid resource with all fields filled", 'error');
                return false;
            }
            
            return true;
        }

        function getParam() {
            var resultList = [];
            $("input[name='resourceId']").each(function(index) {
                var resourceId = $(this).val();
                var homeValue = $("input[name='homeValue']").eq(index).val();
                var awayValue = $("input[name='awayValue']").eq(index).val();
                
                if (resourceId && homeValue && awayValue) {
                    resultList.push({
                        ResourceId: resourceId,
                        HomeValue: homeValue,
                        AwayValue: awayValue
                    });
                }
            });

            return {
                MatchId3rd: parseInt($('#matchId3rd').val()),
                MatchId: parseInt($('#matchId').val()),
                SourceId: parseInt($('#sourceId').val()),
                Resources: resultList,
                SecurityToken: "3BEAED79-1305-4213-BF4D-3B10DF385BA4"
            };
        }

        // Override the pushExternalResults function to add better error handling
        site.pushExternalResults = function () {
            showLoading(true);
            
            var param = site.pushExternalResultsParam();
            if (!param) {
                showLoading(false);
                return;
            }
            
            $.ajax({
                type: "POST",
                url: "/api/score/push-result",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(param),
                success: function (result) {
                    showLoading(false);
                    if (result.errCode === 0) {
                        showAlert("✅ Pushed results successfully", 'success');
                        clearForm();
                    } else {
                         showAlert(`❌ Error: ${result.errMsg || 'Unknown error'}`, 'error');
                    }
                },
                error: function (xhr, status, error) {
                    showLoading(false);
                    
                    var errorMessage = "❌ API Error";
                    if (xhr.responseText) {
                        try {
                            var errorData = JSON.parse(xhr.responseText);
                            errorMessage = `❌ ${errorData.message || errorData.errMsg || 'Bad Request'}`;
                        } catch (e) {
                            errorMessage = `❌ ${xhr.statusText || 'Bad Request'}`;
                        }
                    }
                    
                    showAlert(errorMessage, 'error');
                },
                complete: function () {
                    showLoading(false);
                }
            });
        };

        // Override the addResult function to create better UI
        site.addResult = function () {
            var copy = $("#result-block").html();
            var newBlock = $('<div class="resource-block">' + copy + '</div>');
            $("#container-block").append(newBlock);
            
            // Add remove button to the new block
            var removeBtn = $('<button type="button" class="remove-resource" onclick="removeResource(this)">×</button>');
            newBlock.prepend(removeBtn);
            
            // Clear the input values in the new block
            newBlock.find('input').val('');
            
            // Add smooth animation
            newBlock.hide().fadeIn(300);
        };

        // Override the removeResult function to create better UI
        site.removeResult = function () {
            var results = document.getElementsByClassName("result-child");
            var length = results.length;
            if (length > 1) {
                var lastBlock = $(results[length - 1]).closest('.resource-block');
                lastBlock.fadeOut(300, function() {
                    lastBlock.remove();
                });
            } else {
                showAlert("❌ Cannot remove the last resource block", 'error');
            }
        };

        // Function to remove individual resource blocks
        function removeResource(button) {
            const resourceBlocks = document.querySelectorAll('.resource-block');
            if (resourceBlocks.length > 1) {
                $(button).closest('.resource-block').fadeOut(300, function() {
                    $(this).remove();
                });
            } else {
                showAlert("❌ Cannot remove the last resource block", 'error');
            }
        }

        // Override the pushExternalResultsParam function to add better validation
        site.pushExternalResultsParam = function () {
            var resultList = [];
            var resultsLength = document.getElementsByClassName("result-child").length;
            
            // Validate required fields
            var matchId3rd = $('#matchId3rd').val();
            var matchId = $('#matchId').val();
            var sourceId = $('#sourceId').val();
            
            if (!matchId3rd || matchId3rd === "") {
                showAlert("❌ Please enter MatchId3rd", 'error');
                return null;
            }
            
            if (!matchId || matchId === "") {
                showAlert("❌ Please enter MatchId", 'error');
                return null;
            }
            
            if (!sourceId || sourceId === "") {
                showAlert("❌ Please select SourceId", 'error');
                return null;
            }
            
            // Validate results
            for (var i = 0; i < resultsLength; i++) {
                var resourceId = $("input[name^='resourceId']").eq(i).val();
                var homeValue = $("input[name^='homeValue']").eq(i).val();
                var awayValue = $("input[name^='awayValue']").eq(i).val();
                
                // Skip empty resource blocks
                if (!resourceId && !homeValue && !awayValue) {
                    continue;
                }

                // Validate required fields for each result
                if (!resourceId || resourceId.trim() === "") {
                    showAlert(`❌ Please enter ResourceId for resource ${i + 1}`, 'error');
                    return null;
                }
                
                if (!homeValue || homeValue.trim() === "") {
                    showAlert(`❌ Please enter HomeValue for resource ${i + 1}`, 'error');
                    return null;
                }
                
                if (!awayValue || awayValue.trim() === "") {
                    showAlert(`❌ Please enter AwayValue for resource ${i + 1}`, 'error');
                    return null;
                }

                var resultItem = {
                    resourceId: resourceId.trim(),
                    homeValue: homeValue.trim(),
                    awayValue: awayValue.trim(),
                };
                resultList.push(resultItem);
            }
            
            if (resultList.length === 0) {
                showAlert("❌ Please add at least one resource", 'error');
                return null;
            }
            
            return {
                matchId3rd: parseInt(matchId3rd) || 0,
                matchId: parseInt(matchId) || 0,
                sourceId: parseInt(sourceId) || 1,
                results: resultList,
            };
        };
        
        // Add keyboard shortcuts
        $(document).keydown(function(e) {
            if (e.ctrlKey && e.keyCode === 13) { // Ctrl + Enter
                site.pushExternalResults();
            }
            if (e.keyCode === 27) { // Escape
                clearForm();
            }
        });
    </script>
} 