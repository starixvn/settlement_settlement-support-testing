@using System.Web.Mvc.Html
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <script src="../../scripts/jquery-1.8.3.min.js"></script>
    <script src="../../scripts/broad-cast.js"></script>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
</head>
<body>
    <header>
        @Html.Partial("Menu");
    </header>
    <form class="p-4">
        <div class="form-group row">
            <label for="matchId" class="col-sm-2 col-form-label">MatchId</label>
            <div class="col-sm-10">
                <input type="number" class="form-control" id="matchId" placeholder="MatchId allow number ONLY">
            </div>
        </div>
        <div class="form-group row">
            <label for="action" class="col-sm-2 col-form-label">Action</label>
            <div class="col-sm-10">
                <select class="form-control" id="action">
                    <option value="CAL">CAL</option>
                    <option value="REFUND">REFUND</option>
                </select>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Ball</label>
            <div class="col-sm-10">
                <br />
                <div id="container-block" class="row">
                    <div id="result-block" class="col-sm-3 mx-3 my-3 border border-dark">
                        <table style="width: 100%">
                            <thead>
                                <tr style="text-align: center">
                                    <th>Seq</th>
                                    <th>Ball</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td>
                                        <input type="text" id="ball-1">
                                    </td>
                                </tr>
                                <tr>
                                    <td>2</td>
                                    <td>
                                        <input type="text" id="ball-2">
                                    </td>
                                </tr>
                                <tr>
                                    <td>3</td>
                                    <td>
                                        <input type="text" id="ball-3">
                                    </td>
                                </tr>
                                <tr>
                                    <td>4</td>
                                    <td>
                                        <input type="text" id="ball-4">
                                    </td>
                                </tr>
                                <tr>
                                    <td>5</td>
                                    <td>
                                        <input type="text" id="ball-5">
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-2">
            </div>
            <div class="col-sm-10">
                <input type="button" id="submit" class="btn btn-primary" value="Submit">
            </div>
        </div>
    </form>
</body>
</html>
@Html.Hidden("api-url", System.Configuration.ConfigurationManager.AppSettings["Broad_Cast_Api"])
<script type="text/javascript">
    jQuery(window.document).ready(function () {
        broadCast.init();
    });
</script>
<style>
    td {
        width: 50%;
        text-align: center;
    }

    tr {
        border-bottom: 1px solid;
    }

    #result-block {
        padding: 0px;
    }

    td input {
        width: 50px;
        margin: 4px;
    }
</style>