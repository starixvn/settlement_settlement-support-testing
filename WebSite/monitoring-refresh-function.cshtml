<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <script src="scripts/jquery-1.8.3.min.js"></script>
</head>
<body>
    <form id="UpdateResult">
        <fieldset>
            <legend>Monitoring</legend>
            <table cellpadding="2" cellspacing="2" border="0">
                <tr>
                    <td>
                        <span>HIT:</span>
                        <span id="hit"></span>
                    </td>
                </tr>
                <tr>
                    <td>
                        <span>MISS:</span>
                        <span id="miss"></span>
                    </td>
                </tr>

                <tr>
                    <td>
                        <span>Total:</span>
                        <span id="total"></span>
                    </td>
                </tr>

                <tr>
                    <td>
                        <span>Hit%:</span>
                        <span id="percent"></span>
                    </td>
                </tr>

                <tr>
                    <td>
                        <span>Error:</span>
                        <span id="error"></span>
                    </td>
                </tr>
                
                <tr>
                    <td>
                        <button id="refresh">Refresh</button>
                    </td>
                </tr>
            </table>
        </fieldset>
    </form>
    <br>
</body>
</html>

<script type="text/javascript">
    getSetting();

    function getSetting() {
        $.ajax({
            type: "GET",
            url: "api/monitoring-refresh-function/get",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {
                $('#hit').html(result.hit)
                $('#miss').html(result.miss)
                $('#total').html(parseInt(result.hit) + parseInt(result.miss))
                $('#percent').html(((parseInt(result.hit) / (parseInt(result.hit) + parseInt(result.miss))) * 100).toFixed(2))
                $('#error').html(result.error)
            },

        });
    }

    $('#refresh').click(function (e) {
        getSetting();
    });
</script>