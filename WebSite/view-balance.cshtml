<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <script src="scripts/jquery-1.8.3.min.js"></script>
    <script src="scripts/sites.js"></script>
</head>
<body>
    <h3 class="text-center text-success">Settlement Internal Site</h3>
    <div class="jumbotron">
        <form class="form-inline" method="post">
            <fieldset style="width:300px;">
                CustId:<br>
                <input type="text" id="custId" value="" /><br>
                MatchId:<br>
                <input type="text" id="matchId" value="" /><br>
                <br>
                <input type="button" id="get-balance" value="Get Balance">
            </fieldset>
        </form>
    </div>
    <div id="data" style="display:none"></div>

  
    @Html.Hidden("api-url", System.Configuration.ConfigurationManager.AppSettings["Api_Url"])
</body>
</html>

<script type="text/javascript">
    jQuery(window.document).ready(function () {
        site.init();
    });
</script>