<!DOCTYPE html>
<html>
<head>
    <title>API JT Monitor</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body onload="loadRequest()">

    <input type="text" id="requestInput" rows="4" cols="50" placeholder="BetType1-GoalLine1,BetType2-GoalLine2" />

    <button onclick="addRequest()">Add Market</button>

    <h2>API Requests Monitor</h2>
    <ul id="requestList">
    </ul>

    <script>
        setInterval(function () {
            $.get("/api/monitor/GetRequests", function (data) {
                $("#requestList").empty();
                data.forEach(function (req) {
                    $("#requestList").append("<li>" + req + "</li>");
                });
            });
        }, 5000);

        async function addRequest() {
          
                var input = document.getElementById("requestInput").value;
                if (input.trim() === "") {
                    alert("Please input your markets!");
                    return;
                }

                let response = await fetch('/api/monitor/SendMarket', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ request: input })
                });

            if (!response.ok) {
                alert("Error: Please contact IT");
            } else {
                alert("Success");
            }
        }
       

        async function loadRequest() {
        
                let response = await fetch('/api/monitor/GetMarkets');
                if (response.ok) {
                    let data = await response.json();
                    if (data.length > 0) {
                        document.getElementById("requestInput").value = data
                            .map(market => `${market.BetType}-${market.GoalLine}`)
                            .join(",");
                        updateList(data);
                    }
                }
            if (!response.ok) {
                alert("Error: Please contact IT");
            }
            
        }

        function updateList(markets) {
            var list = document.getElementById("requestList");
            list.innerHTML = "";
            markets.forEach(market => addToList(`${market.BetType}-${market.GoalLine}`));
        }
    </script>
</body>
</html>