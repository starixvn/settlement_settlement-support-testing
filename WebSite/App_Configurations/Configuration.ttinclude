<#@ import namespace="System" #>
<#
	var sites = new SiteInfo[]{
		new SiteInfo
		{
			Environment = SiteEnvironment.LOCAL
		},
		new SiteInfo
		{
			Environment = SiteEnvironment.UAT
		},
		new SiteInfo
		{
			Environment = SiteEnvironment.SIT
		},
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        }
	};
#>
<#+
	enum SiteEnvironment
	{
		LOCAL,
		UAT,
		SIT,
        PRO
	}
	class SiteInfo
	{
		public SiteEnvironment Environment { get; set; }

		public string ApiUrl
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.SIT:
						return "http://napsettlement.starixuat.com/cloneapi/";
				    case SiteEnvironment.UAT:
                        return "";
					default:
                        return "http://napsettlement.starixuat.com/cloneapi/";
                }
            }
        }

		public string LeaguesTestUAT
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
						return @"\\10.18.200.120\ShareConfigs\auto-league-settings.ini";
                   
					case SiteEnvironment.SIT:
                        return @"\\172.16.4.106\ShareConfigs\auto-league-settings.ini";
                    
					case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                        return @"\\10.40.40.73\ShareConfigs\auto-league-settings.ini";
                   
                    default:
                        return string.Empty;
                }
            }
        } 

		public string LeaguesTestPRO
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
						return @"\\10.18.200.104\ShareConfigs\auto-league-settings.ini";
                   
					case SiteEnvironment.SIT:
                        return @"\\172.16.4.106\ShareConfigs\auto-league-settings.ini";
                    
					case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                        return @"\\10.99.99.70\ShareConfigs\auto-league-settings.ini";
                    
                    default:
                        return string.Empty;
                }
            }
        }
	}
#>