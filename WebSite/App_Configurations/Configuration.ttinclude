<#@ import namespace="System" #>
<#
	var sites = new SiteInfo[]{
		new SiteInfo
		{
			Environment = SiteEnvironment.LOCAL
		},
		new SiteInfo
		{
			Environment = SiteEnvironment.UAT
		},
		new SiteInfo
		{
			Environment = SiteEnvironment.SIT
		},
        new SiteInfo
        {
            Environment = SiteEnvironment.PRO
        }
	};
#>
<#+
	enum SiteEnvironment
	{
		LOCAL,
		UAT,
		SIT,
        PRO
	}
	class SiteInfo
	{
		public SiteEnvironment Environment { get; set; }

		public string ApiUrl
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.SIT:
						return "http://napsettlement.starixuat.com/cloneapi/";
				    case SiteEnvironment.UAT:
                        return "";
					default:
                        return "http://napsettlement.starixuat.com/cloneapi/";
                }
            }
        }

		public string RedisServer
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
						return @"ha.nexdev.net";
                   
				   case SiteEnvironment.SIT:
                        return @"172.16.4.109";
					            
					case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                       return @"10.99.99.51";
                    
                    default:
                        return string.Empty;
                }
            }
        } 

		public string RedisPort
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
						return @"16379";
                   
				   case SiteEnvironment.SIT:
                        return @"16379";
					            
					case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                       return @"16379";
                    
                    default:
                        return string.Empty;
                }
            }
        }

		public string RedisPassword
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
						return @"foo1@bared";
                   
				   case SiteEnvironment.SIT:
                        return @"foo1@bared";
					            
					case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                       return @"foo1@bared";

                    default:
                        return string.Empty;
                }
            }
        }

		public string RedisAppName
        {
            get
            {
                switch(Environment)
                {
					case SiteEnvironment.LOCAL:
						return @"Settlement-LOCAL";
                   
				   case SiteEnvironment.SIT:
                        return @"Settlement-SIT";
					            
					case SiteEnvironment.UAT:
					case SiteEnvironment.PRO:
                       return @"Settlement-PRO";
                    
                    default:
                        return string.Empty;
                }
            }
        }
	}
#>