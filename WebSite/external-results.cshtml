<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <script src="scripts/jquery-1.8.3.min.js"></script>
    <script src="scripts/sites.js"></script>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
</head>
<body>
    <form id="ExternalResults" class="p-4">
        <div class="form-group row">
            <label for="matchId3rd" class="col-sm-2 col-form-label">MatchId3rd (Default)</label>
            <div class="col-sm-10">
                <input type="number" class="form-control" id="matchId3rd" value="12365499" placeholder="Any number">
            </div>
        </div>
        <div class="form-group row">
            <label for="matchId" class="col-sm-2 col-form-label">MatchId</label>
            <div class="col-sm-10">
                <input type="number" class="form-control" id="matchId" placeholder="MatchId allow number ONLY">
            </div>
        </div>
        <div class="form-group row">
            <label for="sourceId" class="col-sm-2 col-form-label">SourceId</label>
            <div class="col-sm-10">
                <select class="form-control" id="sourceId">
                    <option value="1">1 - SBO</option>
                    <option value="16">16 - PandaScore</option>
                    <option value="22">22 - GameScorekeeper</option>
                    <option value="24">24 - Weaverdat</option>
                    <option value="25">25 - LSport</option>
                    <option value="31">31 - Sofascore</option>
                    <option value="32">32 - The Sports</option>
                    <option value="201">201 - BetRadar</option>
                </select>
            </div>
        </div>
        <div class="form-group row">
            <label class="col-sm-2 col-form-label">Resources</label>
            <div class="col-sm-10">
                <button id="add-result" type="button" class="btn btn-success">Add</button>
                <button id="remove-result" type="button" class="btn btn-danger">Remove</button>
                <br />
                <div id="container-block" class="row">
                    <div id="result-block" class="col-sm-3 mx-3 my-3 border border-dark">
                        <div class="result-child pt-2">
                            <div class="form-group">
                                <label for="resourceId">ResourceId</label>
                                <input type="text" class="form-control" name="resourceId" placeholder="M1, M2, 00, 01, ...">
                            </div>
                            <div class="form-group">
                                <label for="homeValue">HomeValue</label>
                                <input type="text" class="form-control" name="homeValue" placeholder="0, 1, 2, ...">
                            </div>
                            <div class="form-group">
                                <label for="awayValue">Away Value</label>
                                <input type="text" class="form-control" name="awayValue" placeholder="0, 1, 2, ...">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-2">
            </div>
            <div class="col-sm-10">
                <input type="button" id="form-submit" class="btn btn-primary" value="Submit">
            </div>
        </div>
    </form>
</body>
</html>
<script type="text/javascript">
    jQuery(window.document).ready(function () {
        site.init();
    });
</script>